// Documentación: https://www.prisma.io/docs
//
// La URL de conexión NO vive acá: en Prisma 7 el CLI la lee desde
// prisma.config.ts y el runtime la recibe vía driver adapter (PrismaPg),
// configurado en src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client"

  // `prisma-client-js` está deprecado. El generador nuevo exige un `output`
  // explícito y genera dentro del proyecto en vez de node_modules.
  // Tiene que caer dentro de src/ porque tsconfig.build.json compila
  // únicamente ese directorio (rootDir: ./src, include: ["src"]).
  output = "../src/generated/prisma"

  // Query compiler en WASM: sin binario nativo de Rust, lo que permite usar
  // imágenes Alpine sin instalar libssl.
  engineType = "client"
  runtime    = "nodejs"

  // El proyecto es ESM puro ("type": "module" + moduleResolution nodenext),
  // así que el cliente se genera como ESM y sus imports relativos llevan la
  // extensión .js que tsc espera al emitir.
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Rol del usuario (H38). Una cuenta tiene un solo rol.
enum Role {
  RESIDENTE
  ADMINISTRADOR
  SEGURIDAD
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  /// Unidad del residente (H38). Obligatoria para RESIDENTE (lo garantiza un
  /// CHECK en la migración); null para administración y seguridad.
  unitId       String?  @map("unit_id") @db.Uuid
  unit         Unit?    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile               Profile?
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  /// Incidencias que reportó (H10).
  reportedIncidents     Incident[]           @relation("IncidentReporter")
  /// Asambleas que convocó (H22).
  assembliesCreated     Assembly[]
  /// Eventos del historial de incidencias que registró (H10-H13).
  incidentEvents        IncidentEvent[]
  /// Paquetes que registró como agente de seguridad (H19).
  receivedPackages      Package[]            @relation("PackageReceiver")
  /// Paquetes que entregó como agente de seguridad (H21).
  deliveredPackages     Package[]            @relation("PackageDeliverer")
  /// Áreas comunes que modificó por última vez (H9).
  updatedAreas          CommonArea[]         @relation("CommonAreaUpdatedBy")
  /// Bloqueos de áreas que registró (H9).
  areaBlocks            AreaBlock[]
  /// Reservas que hizo como residente (H7).
  reservations          Reservation[]        @relation("ReservationUser")
  /// Reservas que canceló (H8 el residente, H9 la administración).
  cancelledReservations Reservation[]        @relation("ReservationCancelledBy")
  feeGenerations        FeeGeneration[]
  directoryPreference   DirectoryPreference?

  @@index([unitId])
  @@map("users")
}

/// Datos personales del usuario (H38), 1 a 1 con User.
model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 2 a 80 caracteres.
  fullName   String @map("full_name") @db.VarChar(80)
  /// Nombre en minúsculas y sin tildes, para buscar en el directorio.
  searchName String @map("search_name") @db.VarChar(80)
  /// Formato 0000-0000.
  phone      String @db.VarChar(9)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([searchName])
  @@map("profiles")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  // Se guarda el SHA-256 del token, nunca el token en claro: si se filtra la
  // base, los refresh tokens emitidos no son utilizables.
  tokenHash String @unique @map("token_hash")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// Torre del condominio (H39).
model Tower {
  id     String @id @default(uuid()) @db.Uuid
  /// "Torre A"
  name   String @unique @db.VarChar(30)
  /// "A"
  letter String @unique @db.Char(1)
  units  Unit[]

  @@map("towers")
}

/// Unidad (apartamento) de una torre (H39).
model Unit {
  id      String @id @default(uuid()) @db.Uuid
  towerId String @map("tower_id") @db.Uuid
  tower   Tower  @relation(fields: [towerId], references: [id])

  /// Número dentro de la torre: piso + posición, "101".."404".
  number           String   @db.Char(3)
  /// Código visible de la unidad, "A-101".
  code             String   @unique @db.VarChar(5)
  /// Código de 8 caracteres que la administración entrega al residente para
  /// registrarse (H38). Sin caracteres ambiguos (I, L, O, 0, 1).
  registrationCode String   @unique @map("registration_code") @db.Char(8)
  createdAt        DateTime @default(now()) @map("created_at")

  /// Cuentas de residentes de la unidad (H38), máximo 4.
  residents          User[]
  /// Reservas de áreas comunes de la unidad (H7).
  reservations       Reservation[]
  incidents          Incident[]
  /// Paquetes que llegaron para la unidad (H19).
  packages           Package[]
  /// Asambleas en las que la unidad quedó habilitada para votar (H22).
  eligibleAssemblies AssemblyEligibleUnit[]
  fees               Fee[]

  @@unique([towerId, number])
  @@map("units")
}

/// Módulo que originó una notificación (H30).
enum SourceModule {
  CUOTAS
  RESERVAS
  INCIDENCIAS
  VISITAS
  PAQUETERIA
  VOTACIONES
  COMUNICADOS
}

/// Aviso para un usuario (H30). Lo crea únicamente NotificationsService.send;
/// la bandeja de H31 lo muestra. No se borran en la prueba de concepto.
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  /// Destinatario.
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1 a 100 caracteres.
  title        String       @db.VarChar(100)
  /// 1 a 500 caracteres.
  message      String       @db.VarChar(500)
  sourceModule SourceModule @map("source_module")

  /// Registro que originó el aviso, por ejemplo "incident" + id de la incidencia.
  referenceType String? @map("reference_type") @db.VarChar(30)
  referenceId   String? @map("reference_id") @db.Uuid

  /// null = No leída.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Módulo 3: incidencias (H10; H11-H13 usan los mismos modelos)
// ---------------------------------------------------------------------------

/// Lugar del condominio donde ocurre la incidencia (H10).
enum IncidentLocation {
  TORRE_A
  TORRE_B
  TORRE_C
  ESTACIONAMIENTO
  PISCINA
  GIMNASIO
  SALON
  ASADOR
  LOBBY
  AREAS_VERDES
  OTRA
}

enum IncidentStatus {
  PENDIENTE
  EN_PROCESO
  RESUELTO
}

enum IncidentPriority {
  BAJA
  MEDIA
  ALTA
}

/// Tipo de evento del historial (definido en H13).
enum IncidentEventType {
  CREACION
  ESTADO
  PRIORIDAD
  ASIGNACION
}

/// Responsable de mantenimiento (definido en H12). Catálogo sin acceso al
/// sistema; lo carga el script de datos iniciales (H39).
model MaintenanceStaff {
  id        String   @id @default(uuid()) @db.Uuid
  /// 3 a 80 caracteres.
  name      String   @db.VarChar(80)
  /// "Fontanería", "Electricidad"… Máximo 40 caracteres.
  specialty String   @db.VarChar(40)
  /// Formato 0000-0000.
  phone     String   @db.VarChar(9)
  /// Borrado lógico.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incidents Incident[]

  @@map("maintenance_staff")
}

/// Incidencia reportada por un residente (H10). No se borran.
model Incident {
  id     String @id @default(uuid()) @db.Uuid
  /// INC-AAAA-NNNNN: año y consecutivo anual (ver IncidentCounter).
  number String @unique @db.VarChar(14)

  unitId     String @map("unit_id") @db.Uuid
  unit       Unit   @relation(fields: [unitId], references: [id])
  /// Residente que la reportó.
  reporterId String @map("reporter_id") @db.Uuid
  reporter   User   @relation("IncidentReporter", fields: [reporterId], references: [id])

  /// 5 a 80 caracteres.
  title          String           @db.VarChar(80)
  /// 10 a 1,000 caracteres.
  description    String           @db.VarChar(1000)
  location       IncidentLocation
  /// "Piso 3, pasillo norte". Máximo 100 caracteres.
  locationDetail String?          @map("location_detail") @db.VarChar(100)
  /// Número y título en minúsculas y sin tildes, para la búsqueda de H12.
  searchKey      String           @map("search_key") @db.VarChar(100)

  status     IncidentStatus    @default(PENDIENTE)
  priority   IncidentPriority  @default(MEDIA)
  /// Responsable de mantenimiento asignado (H12).
  assigneeId String?           @map("assignee_id") @db.Uuid
  assignee   MaintenanceStaff? @relation(fields: [assigneeId], references: [id])
  /// Se llena al pasar a Resuelto y se borra al reabrir (H13).
  resolvedAt DateTime?         @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  photos IncidentPhoto[]
  events IncidentEvent[]

  @@index([unitId, createdAt])
  @@index([status, priority, createdAt])
  @@map("incidents")
}

/// Fotografía de una incidencia (H10): de 1 a 3 por incidencia.
model IncidentPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id])

  /// Ruta interna relativa a la carpeta de uploads: incidencias/<id>/<archivo>.
  path      String   @db.VarChar(255)
  /// image/jpeg o image/png.
  mimeType  String   @map("mime_type") @db.VarChar(20)
  /// Máximo 5,242,880 (5 MB).
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([incidentId])
  @@map("incident_photos")
}

/// Evento del historial de una incidencia (definido en H13; H10 crea el
/// primero). Los eventos no se modifican ni se borran.
model IncidentEvent {
  id         String            @id @default(uuid()) @db.Uuid
  incidentId String            @map("incident_id") @db.Uuid
  incident   Incident          @relation(fields: [incidentId], references: [id])
  type       IncidentEventType

  /// Solo en eventos ESTADO.
  fromStatus IncidentStatus? @map("from_status")
  toStatus   IncidentStatus? @map("to_status")
  /// Prioridad o responsable anterior y nuevo (PRIORIDAD, ASIGNACION).
  fromValue  String?         @map("from_value") @db.VarChar(100)
  toValue    String?         @map("to_value") @db.VarChar(100)
  /// Máximo 500 caracteres; obligatorio en eventos ESTADO.
  note       String?         @db.VarChar(500)

  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

/// Último consecutivo usado por año para el número INC-AAAA-NNNNN (H10).
/// Se incrementa con INSERT ... ON CONFLICT dentro de la transacción que crea
/// la incidencia, así dos registros simultáneos nunca reciben el mismo número.
model IncidentCounter {
  year Int @id
  last Int

  @@map("incident_counters")
}

// ---------------------------------------------------------------------------
// Módulo de paquetería (H19; H20 y H21 usan el mismo modelo)
// ---------------------------------------------------------------------------

enum PackageStatus {
  PENDIENTE_ENTREGA
  ENTREGADO
}

/// Documento de quien recoge un paquete (H21).
enum DocumentType {
  DUI
  PASAPORTE
}

/// Paquete que llega a portería para una unidad (H19). No se borran.
model Package {
  id   String @id @default(uuid()) @db.Uuid
  /// PQ-AAAAMMDD-NNNN (ver PackageCounter).
  code String @unique @db.VarChar(20)

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id])

  /// 2 a 40 caracteres.
  courier        String        @db.VarChar(40)
  /// 4 a 40 caracteres: letras, números y guiones.
  trackingNumber String?       @map("tracking_number") @db.VarChar(40)
  /// Máximo 200 caracteres.
  notes          String?       @db.VarChar(200)
  status         PackageStatus @default(PENDIENTE_ENTREGA)
  receivedAt     DateTime      @default(now()) @map("received_at")

  /// Agente de seguridad que lo registró.
  receivedById String @map("received_by_id") @db.Uuid
  receivedBy   User   @relation("PackageReceiver", fields: [receivedById], references: [id])

  // Entrega (H21).
  deliveredAt         DateTime?     @map("delivered_at")
  deliveredById       String?       @map("delivered_by_id") @db.Uuid
  deliveredBy         User?         @relation("PackageDeliverer", fields: [deliveredById], references: [id])
  /// 3 a 80 caracteres.
  pickedUpByName      String?       @map("picked_up_by_name") @db.VarChar(80)
  pickedUpByDocType   DocumentType? @map("picked_up_by_doc_type")
  /// Según el tipo de documento.
  pickedUpByDocNumber String?       @map("picked_up_by_doc_number") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, receivedAt])
  @@index([unitId, status])
  @@map("packages")
}

/// Último consecutivo usado por día para el código PQ-AAAAMMDD-NNNN (H19).
/// Mismo patrón que IncidentCounter: se incrementa con INSERT ... ON CONFLICT
/// dentro de la transacción que crea el paquete.
model PackageCounter {
  /// AAAAMMDD
  day  String @id @db.Char(8)
  last Int

  @@map("package_counters")
}

// --- Módulo 2: reservas de áreas comunes (H9, H7, H6, H8) -------------------

/// Estado de una reserva. CANCELADA la cancela el residente (H8);
/// CANCELADA_ADMIN, la administración al cambiar o bloquear el área (H9).
enum ReservationStatus {
  CONFIRMADA
  CANCELADA
  CANCELADA_ADMIN
}

/// Área común reservable (H9). No se borra: se deshabilita con isActive.
model CommonArea {
  id          String  @id @default(uuid()) @db.Uuid
  /// 3 a 50 caracteres.
  name        String  @db.VarChar(50)
  /// Nombre en minúsculas y sin tildes: evita duplicados como "Piscina" y "piscina".
  nameKey     String  @unique @map("name_key") @db.VarChar(50)
  /// Aforo máximo, de 1 a 500 personas.
  capacity    Int
  /// Máximo 500 caracteres.
  rules       String? @db.VarChar(500)
  /// "HH:mm" en pasos de 30 minutos; el cierre es posterior a la apertura.
  openTime    String  @map("open_time") @db.Char(5)
  closeTime   String  @map("close_time") @db.Char(5)
  /// Duración de cada franja: 60 o 120 minutos.
  slotMinutes Int     @map("slot_minutes")
  isActive    Boolean @default(true) @map("is_active")

  /// Último administrador que la modificó.
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedBy   User?   @relation("CommonAreaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blocks       AreaBlock[]
  reservations Reservation[]

  @@map("common_areas")
}

/// Bloqueo de un área por mantenimiento (H9). Se borra físicamente; borrarlo
/// no restaura las reservas que canceló.
model AreaBlock {
  id     String     @id @default(uuid()) @db.Uuid
  areaId String     @map("area_id") @db.Uuid
  area   CommonArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  /// Rango inclusivo de 1 a 90 días.
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  /// 5 a 200 caracteres.
  reason    String   @db.VarChar(200)

  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([areaId, endDate])
  @@map("area_blocks")
}

/// Reserva de una franja de un área (H7). La crea H9 porque H9 cancela
/// reservas; H7 agrega el endpoint para reservar.
model Reservation {
  id   String @id @default(uuid()) @db.Uuid
  /// RS-AAAAMMDD-NNNN, único.
  code String @unique @db.VarChar(16)

  areaId String     @map("area_id") @db.Uuid
  area   CommonArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  unitId String     @map("unit_id") @db.Uuid
  unit   Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// Residente que reservó.
  userId String     @map("user_id") @db.Uuid
  user   User       @relation("ReservationUser", fields: [userId], references: [id], onDelete: Restrict)

  date      DateTime @db.Date
  /// "HH:mm"; coinciden con una franja del área.
  startTime String   @map("start_time") @db.Char(5)
  endTime   String   @map("end_time") @db.Char(5)
  /// De 1 al aforo del área.
  attendees Int

  status  ReservationStatus @default(CONFIRMADA)
  /// "<areaId>|<fecha>|<inicio>", único y lleno solo mientras está CONFIRMADA:
  /// la base impide dos reservas confirmadas en la misma franja (H7).
  slotKey String?           @unique @map("slot_key") @db.VarChar(60)

  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id") @db.Uuid
  cancelledBy   User?     @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  /// Máximo 200 caracteres.
  cancelReason  String?   @map("cancel_reason") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([areaId, status, date])
  @@index([unitId, status])
  @@map("reservations")
}

/// Estado de una asamblea (H22). El cambio lo hace una tarea programada.
enum AssemblyStatus {
  PROGRAMADA
  ABIERTA
  CERRADA
}

/// Asamblea de votación (H22).
model Assembly {
  id          String         @id @default(uuid()) @db.Uuid
  /// 5 a 100 caracteres.
  title       String         @db.VarChar(100)
  /// Máximo 1,000 caracteres.
  description String?        @db.VarChar(1000)
  startsAt    DateTime       @map("starts_at")
  endsAt      DateTime       @map("ends_at")
  status      AssemblyStatus @default(PROGRAMADA)
  /// Momento real de apertura y de cierre.
  openedAt    DateTime?      @map("opened_at")
  closedAt    DateTime?      @map("closed_at")
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  createdBy     User                   @relation(fields: [createdById], references: [id])
  topics        AssemblyTopic[]
  eligibleUnits AssemblyEligibleUnit[]

  @@index([status, startsAt])
  @@index([status, endsAt])
  @@map("assemblies")
}

/// Tema de la agenda (H22): de 1 a 10 por asamblea.
model AssemblyTopic {
  id         String @id @default(uuid()) @db.Uuid
  assemblyId String @map("assembly_id") @db.Uuid
  /// 1 a 10.
  order      Int
  /// 5 a 200 caracteres.
  question   String @db.VarChar(200)

  assembly Assembly      @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  options  TopicOption[]

  @@unique([assemblyId, order])
  @@map("assembly_topics")
}

/// Opción de voto de un tema (H22): de 2 a 6 por tema.
model TopicOption {
  id      String @id @default(uuid()) @db.Uuid
  topicId String @map("topic_id") @db.Uuid
  /// 1 a 80 caracteres.
  text    String @db.VarChar(80)
  /// 1 a 6.
  order   Int

  topic AssemblyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, text])
  @@map("topic_options")
}

/// Unidades habilitadas para votar. Se crean al abrir la asamblea y no cambian.
model AssemblyEligibleUnit {
  assemblyId String @map("assembly_id") @db.Uuid
  unitId     String @map("unit_id") @db.Uuid

  assembly Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([assemblyId, unitId])
  @@map("assembly_eligible_units")
}

enum FeeStatus {
  PENDIENTE
  PAGADO
  MOROSO
}

model FeeGeneration {
  id           String   @id @default(uuid()) @db.Uuid
  period       String   @db.Char(7)
  amount       Decimal  @db.Decimal(10, 2)
  dueDate      DateTime @map("due_date") @db.Date
  concept      String   @db.VarChar(60)
  createdCount Int      @map("created_count")
  skippedCount Int      @map("skipped_count")
  createdById  String   @map("created_by_id") @db.Uuid
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  fees Fee[]

  @@map("fee_generations")
}

model Fee {
  id             String        @id @default(uuid()) @db.Uuid
  unitId         String        @map("unit_id") @db.Uuid
  unit           Unit          @relation(fields: [unitId], references: [id])
  generationId   String        @map("generation_id") @db.Uuid
  generation     FeeGeneration @relation(fields: [generationId], references: [id])
  period         String        @db.Char(7)
  concept        String        @db.VarChar(60)
  amount         Decimal       @db.Decimal(10, 2)
  dueDate        DateTime      @map("due_date") @db.Date
  status         FeeStatus     @default(PENDIENTE)
  paidAt         DateTime?     @map("paid_at")
  overdueAt      DateTime?     @map("overdue_at")
  reminderSentAt DateTime?     @map("reminder_sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([unitId, period])
  @@map("fees")
}

// ---------------------------------------------------------------------------
// Módulo 8: directorio (H28, H29)
// ---------------------------------------------------------------------------

model DirectoryPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  visible   Boolean  @default(false)
  showName  Boolean  @default(false) @map("show_name")
  showUnit  Boolean  @default(false) @map("show_unit")
  showPhone Boolean  @default(false) @map("show_phone")
  showEmail Boolean  @default(false) @map("show_email")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("directory_preferences")
}
